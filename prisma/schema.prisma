// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Admin ----------

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Elvira")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- Cuenta de clienta ----------

model Customer {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  phone           String?
  // Null for accounts created (or linked) via Google sign-in that never set
  // a password of their own.
  passwordHash    String?
  googleId        String? @unique
  newsletterOptIn Boolean @default(true)

  orders   Order[]
  messages ContactMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  // SHA-256 hash of the token sent by email — the raw token is never stored,
  // same principle as a password hash: a DB leak alone can't be used to
  // reset anyone's account.
  tokenHash  String    @unique
  customerId String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

// ---------- Catálogo ----------

enum PublicationStatus {
  PUBLICADO
  BORRADOR
  ARCHIVADO
}

enum PieceStatus {
  DISPONIBLE
  TRABAJANDO_EN_ELLO
  RESERVADO
  VENDIDO
  VENDIDO_POR_ENCARGO
}

enum PriceType {
  STOCK
  PERSONALIZADO
}

enum MediaType {
  IMAGE
  VIDEO
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  coverImage  String?
  coverFocalX Float   @default(0.5)
  coverFocalY Float   @default(0.5)
  order       Int     @default(0)

  metaTitle       String?
  metaDescription String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A franchise/collection tag (e.g. Pokémon, Dragon Ball) independent of
// Category, so the same brand can span multiple categories over time.
model Brand {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  order Int    @default(0)

  metaTitle       String?
  metaDescription String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  shortDescription String?
  description      String?
  materials        String? // texto multilínea, un material por línea

  mainImage       String?
  mainImageFocalX Float          @default(0.5)
  mainImageFocalY Float          @default(0.5)
  images          ProductImage[]

  metaTitle       String?
  metaDescription String?

  publicationStatus PublicationStatus @default(BORRADOR)
  pieceStatus       PieceStatus       @default(DISPONIBLE)
  featured          Boolean           @default(false)

  priceType PriceType @default(STOCK)
  price     Decimal   @db.Decimal(10, 2)

  likes Int @default(0)
  views Int @default(0)

  instagramUrl String?
  tiktokUrl    String?

  categories Category[]
  brands     Brand[]

  campaigns   Campaign[]
  relatedTo   Product[] @relation("RelatedProducts")
  relatedFrom Product[] @relation("RelatedProducts")

  orders      Order[]
  socialPosts SocialPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicationStatus])
  @@index([pieceStatus])
}

model ProductImage {
  id        String    @id @default(cuid())
  url       String
  mediaType MediaType @default(IMAGE)
  // Poster frame shown for a video thumbnail/before playback; unused for images.
  posterUrl String?
  alt       String?
  order     Int       @default(0)
  focalX    Float     @default(0.5)
  focalY    Float     @default(0.5)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

// ---------- Pedidos / encargos ----------

enum OrderType {
  PERSONALIZADO
  RESERVA_STOCK
}

enum OrderState {
  NUEVO
  COTIZADO
  CONFIRMADO
  ENVIADO
  ENTREGADO
}

model Order {
  id  String @id @default(cuid())
  ref String @unique // ENC-2026-084 / RES-2026-041

  clientName  String
  clientPhone String
  clientEmail String?

  requestText String
  targetDate  DateTime?

  type  OrderType  @default(PERSONALIZADO)
  state OrderState @default(NUEVO)

  referenceImages OrderImage[]
  internalNotes   String?

  budgetLines BudgetLine[]

  product   Product? @relation(fields: [productId], references: [id])
  productId String?

  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([state])
  @@index([type])
}

model OrderImage {
  id      String @id @default(cuid())
  url     String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  @@index([orderId])
}

model BudgetLine {
  id      String  @id @default(cuid())
  concept String
  price   Decimal @db.Decimal(10, 2)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  @@index([orderId])
}

// ---------- Contenido del sitio ----------

enum SubscriberState {
  ACTIVO
  BAJA
}

model Subscriber {
  id           String          @id @default(cuid())
  email        String          @unique
  state        SubscriberState @default(ACTIVO)
  subscribedAt DateTime        @default(now())
}

model Testimonial {
  id      String  @id @default(cuid())
  text    String
  author  String
  origin  String? // ej. "Madrid · Pendientes Donut personalizados"
  visible Boolean @default(true)
  order   Int     @default(0)

  createdAt DateTime @default(now())
}

model Faq {
  id       String @id @default(cuid())
  question String
  answer   String
  order    Int    @default(0)
}

model LegalPage {
  id      String @id @default(cuid())
  slug    String @unique // "aviso" | "privacidad" | "cookies"
  title   String
  content String // HTML simple generado por el editor del admin

  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  contact   String // email o teléfono
  message   String
  createdAt DateTime @default(now())

  // Set when the sender was signed in, so it shows in their account.
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?

  readAt    DateTime? // opened by the owner in the admin inbox
  reply     String? // owner's answer, shown in the customer's account
  repliedAt DateTime?
  replySeenAt DateTime? // the customer opened Mensajes after the reply

  @@index([customerId])
}

model SiteSettings {
  id Int @id @default(1)

  phone       String @default("+34 600 00 00 00")
  publicEmail String @default("infomundolana@gmail.com")

  hoursWeekday  String @default("10:00 – 19:00")
  hoursSaturday String @default("10:00 – 14:00")
  hoursSunday   String @default("Cerrado")

  instagramUrl String @default("instagram.com/mundodelana16")
  tiktokUrl    String @default("")

  // Words that rotate after "Tejido a mano," in the home banner.
  heroPhrases String[] @default(["pensado para ti", "para regalar", "con mucho cariño", "a tu medida", "en Galicia"])

  aboutPhoto    String?
  aboutHeadline String  @default("Soy Elvira y tejo desde mi taller en Galicia")
  aboutText     String  @default("Empecé haciendo amigurumis para mi hijo y, paso a paso, aquello acabó convirtiéndose en mi propio taller. Cinco años después sigo en la misma silla, con mejor luz y bastante más lana.")

  defaultMetaTitle       String @default("Mundolana · crochet y amigurumis hechos a mano en España")
  defaultMetaDescription String @default("Amigurumis, decoración y piezas de bebé tejidas a mano por encargo, con algodón 100 % de alta calidad. Envíos a toda España desde Galicia.")
}

// ---------- Preparación de publicaciones en redes ----------

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
}

model SocialPost {
  id String @id @default(cuid())

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  // Media específica de esta publicación: puede diferir de las fotos de la ficha.
  mediaUrl  String?
  mediaType String? // "image" | "video"

  instagramText String?
  tiktokText    String?

  // Recordatorio interno para TikTok: no se publica nada automáticamente ahí.
  scheduledFor DateTime?

  // Estado de la publicación real en Instagram vía API. Null = todavía no
  // se ha intentado publicar (sigue siendo solo un borrador/recordatorio).
  instagramPostId        String?
  instagramPermalink     String?
  instagramPublishedAt   DateTime?
  instagramPublishError  String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([scheduledFor])
}

// Photo/video library: media pulled in from Instagram (or uploaded) before it
// is turned into products or gallery items. Originals are kept untouched so
// they can be exported for AI image generation.
enum LibraryStatus {
  NUEVA
  USADA
  DESCARTADA
}

model LibraryMedia {
  id String @id @default(cuid())

  source String @default("instagram") // "instagram" | "upload" | "ai"

  // One row per photo/video; carousel children share instagramPostId.
  instagramMediaId String?   @unique
  instagramPostId  String?
  permalink        String?
  caption          String?
  takenAt          DateTime?

  url       String
  mediaType MediaType @default(IMAGE)
  posterUrl String?
  width     Int?
  height    Int?

  status LibraryStatus @default(NUEVA)

  // Public "Trabajos hechos" gallery
  showInGallery Boolean @default(false)
  galleryTitle  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instagramPostId])
  @@index([status])
}

// Images for fixed spots of the public site (home hero, about, how it works,
// contact). Keyed by spot so the code knows where each one goes.
model SiteImage {
  key       String   @id // "hero" | "about" | "how" | "contact"
  url       String
  focalX    Float    @default(0.5)
  focalY    Float    @default(0.5)
  updatedAt DateTime @updatedAt
}

// Yearly dates people order for (Valentine's, Mother's Day, Christmas...).
// Dates are "MM-DD" so they repeat every year; a window may wrap the new year.
model Campaign {
  id     String @id @default(cuid())
  slug   String @unique
  name   String
  active Boolean @default(true)
  order  Int     @default(0)

  startMD    String // shown from this day ("11-01")
  endMD      String // until this day, inclusive ("01-06")
  deadlineMD String? // last day to order with delivery in time

  bannerTitle String
  bannerText  String
  bannerImage String?
  bannerFocalX Float @default(0.5)
  bannerFocalY Float @default(0.5)
  accent      String @default("#E8B4B8")

  metaDescription String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
