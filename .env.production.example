# Copia este archivo como .env en el VPS (junto a docker-compose.prod.yml) y rellena
# todos los valores con datos reales. NUNCA subas el .env real a git.

# ---------- PostgreSQL ----------
# Usuario, contraseña y nombre de la base de datos del contenedor "db".
# Genera una contraseña fuerte, por ejemplo con: openssl rand -base64 32
POSTGRES_USER=mundodelana
POSTGRES_PASSWORD=
POSTGRES_DB=mundodelana

# ---------- App ----------
# Secreto usado para firmar las cookies de sesión (admin y clientas).
# Genera uno con: openssl rand -base64 48
NEXTAUTH_SECRET=

# URL pública final del sitio (con https y el dominio real).
NEXTAUTH_URL=https://mundolana.es

# ---------- Usuario admin inicial ----------
# Estas dos variables NO las lee el contenedor en marcha: solo se usan cuando
# ejecutas manualmente `docker compose exec app npm run db:seed` la primera vez,
# para crear (o actualizar) el usuario administrador del backoffice.
# La contraseña debe tener al menos 12 caracteres — el seed falla si es más corta.
ADMIN_EMAIL=elvira@mundolana.es
ADMIN_PASSWORD=

# ---------- Claude / IA (opcional: generación de SEO y descripciones) ----------
# API key de https://console.anthropic.com  (empieza por sk-ant-...)
ANTHROPIC_API_KEY=

# ---------- Resend (email transaccional: recuperar contraseña, etc.) ----------
# API key de https://resend.com/api-keys (Sending access)
RESEND_API_KEY=
# Dirección "De:" para los correos. Debe ser de un dominio verificado en Resend.
RESEND_FROM_EMAIL=Mundolana <no-responder@mundolana.es>

# ---------- Google OAuth (login de clientas con Google) ----------
# console.cloud.google.com -> proyecto "Mundolana" -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Auth.js: firma las cookies/JWT de sesión de este proveedor. Genera con: openssl rand -base64 32
AUTH_SECRET=
